# 管理员初始账户凭据（必填）
# 首次登录时若 admin_users 表为空，将用以下凭据创建初始 super_admin 账户；
# 之后请改用数据库内账户管理（web 后台 /users 或直接操作 admin_users 表）。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password